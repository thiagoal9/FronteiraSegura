digraph FronteiraSegura {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.45, ranksep=0.7, pad=0.3, bgcolor="white", label="FronteiraSegura — Diagrama de Classes", labelloc=t, fontsize=20];
  node  [shape=record, fontname="Helvetica", fontsize=10, style=filled, fillcolor="#FFFFFF", color="#333333"];
  edge  [fontname="Helvetica", fontsize=9, color="#333333"];

  // ---------- Núcleo ----------
  MotorRisco [fillcolor="#FFF3CD", label="{MotorRisco|+ repositorio: RepositorioDados\l+ config: ConfigRisco\l+ verificador: VerificadorFacial\l+ analisadores: list[Analisador]\l+ auditoria: RegistroAuditoria\l|+ avaliar(verificacao): RelatorioRisco\l- _identificar_condutor(...): Pessoa\l- _classificar(pontuacao): NivelRisco\l}"];

  Analisador [fillcolor="#E8F0FE", label="{«abstract»\nAnalisador|+ nome: str\l+ config: ConfigRisco\l|+ analisar(ctx): list[Alerta]\l}"];
  AnalisadorFacial [fillcolor="#E8F0FE", label="{AnalisadorFacial|+ verificador: VerificadorFacial\l|+ analisar(ctx): list[Alerta]\l}"];
  AnalisadorCriminal [fillcolor="#E8F0FE", label="{AnalisadorCriminal||+ analisar(ctx): list[Alerta]\l}"];
  AnalisadorRota [fillcolor="#E8F0FE", label="{AnalisadorRota||+ analisar(ctx): list[Alerta]\l- _contar_bate_e_volta(seq): int\l}"];
  AnalisadorBancario [fillcolor="#E8F0FE", label="{AnalisadorBancario||+ analisar(ctx): list[Alerta]\l- _valor_atipico(...): Alerta\l- _fracionamento(...): Alerta\l}"];

  VerificadorFacial [fillcolor="#E8F0FE", label="{VerificadorFacial|+ limiar: float\l|+ distancia(a, b): float\l+ confere(a, b): bool\l+ identificar(emb, pessoas): Pessoa\l}"];
  ContextoAnalise [fillcolor="#E8F0FE", label="{ContextoAnalise|+ verificacao: Verificacao\l+ veiculo: Veiculo\l+ proprietario: Pessoa\l+ condutor: Pessoa\l+ repositorio: RepositorioDados\l}"];
  ConfigRisco [fillcolor="#E8F0FE", label="{ConfigRisco|+ limiar_facial: float\l+ limite_travessias: int\l+ janela_banco_horas: int\l+ limite_valor: int\l+ pesos e limites...\l}"];

  // ---------- Dados ----------
  RepositorioDados [fillcolor="#E6F4EA", label="{RepositorioDados|- _pessoas: dict\l- _veiculos: dict\l- _travessias: list\l- _transacoes: list\l|+ adicionar_pessoa(p)\l+ adicionar_veiculo(v)\l+ registrar_travessia(t)\l+ registrar_transacao(t)\l+ buscar_pessoa(cpf): Pessoa\l+ buscar_veiculo(placa): Veiculo\l+ travessias_da_pessoa(...)\l+ transacoes_da_pessoa(...)\l}"];
  RegistroAuditoria [fillcolor="#E6F4EA", label="{RegistroAuditoria|+ caminho: str\l|+ registrar(relatorio)\l+ entradas: list[str]\l}"];
  GeradorDados [fillcolor="#E6F4EA", label="{GeradorDados|+ rng: Random\l|+ nova_pessoa(...): Pessoa\l+ embedding(): list[float]\l+ captura_de(emb): list[float]\l+ historico_bancario(...)\l+ registrar_viagens(...)\l+ montar_cenarios(): tuple\l}"];
  CenarioDemo [fillcolor="#E6F4EA", label="{CenarioDemo|+ titulo: str\l+ descricao: str\l+ verificacao: Verificacao\l}"];

  // ---------- Entidades ----------
  Pessoa [fillcolor="#FCE8E6", label="{Pessoa|+ cpf: str\l+ nome: str\l+ embedding_facial: list[float]\l+ antecedentes: list[str]\l+ mandado_prisao: bool\l|+ cpf_mascarado: str\l}"];
  Veiculo [fillcolor="#FCE8E6", label="{Veiculo|+ placa: str\l+ proprietario_cpf: str\l+ queixa_roubo: bool\l}"];
  PostoFronteira [fillcolor="#FCE8E6", label="{PostoFronteira|+ nome: str\l+ cidade_brasil: str\l+ cidade_paraguai: str\l}"];
  Travessia [fillcolor="#FCE8E6", label="{Travessia|+ cpf: str\l+ placa: str\l+ posto: PostoFronteira\l+ sentido: Sentido\l+ data_hora: datetime\l}"];
  TransacaoBancaria [fillcolor="#FCE8E6", label="{TransacaoBancaria|+ cpf: str\l+ tipo: TipoTransacao\l+ valor: float\l+ data_hora: datetime\l}"];
  Verificacao [fillcolor="#FCE8E6", label="{Verificacao|+ placa: str\l+ embedding_capturado: list[float]\l+ posto: PostoFronteira\l+ sentido: Sentido\l+ momento: datetime\l}"];
  Alerta [fillcolor="#FCE8E6", label="{Alerta|+ codigo: str\l+ descricao: str\l+ pontos: int\l+ origem: str\l}"];
  RelatorioRisco [fillcolor="#FCE8E6", label="{RelatorioRisco|+ verificacao: Verificacao\l+ alertas: list[Alerta]\l+ pontuacao: int\l+ nivel: NivelRisco\l+ recomendacao: str\l+ condutor: Pessoa\l|+ texto(): str\l}"];

  // ---------- Enums ----------
  NivelRisco [fillcolor="#F3E8FD", label="{«enumeration»\nNivelRisco|BAIXO\lMEDIO\lALTO\l}"];
  Sentido [fillcolor="#F3E8FD", label="{«enumeration»\nSentido|BR_PY\lPY_BR\l}"];
  TipoTransacao [fillcolor="#F3E8FD", label="{«enumeration»\nTipoTransacao|SAQUE\lDEPOSITO\l}"];

  // ---------- Herança ----------
  edge [arrowhead=empty, style=solid];
  AnalisadorFacial -> Analisador;
  AnalisadorCriminal -> Analisador;
  AnalisadorRota -> Analisador;
  AnalisadorBancario -> Analisador;

  // ---------- Agregação / composição ----------
  edge [arrowhead=none, arrowtail=odiamond, dir=back, style=solid, label=""];
  MotorRisco -> Analisador [headlabel="1..*", labeldistance=1.8];
  RepositorioDados -> Pessoa;
  RepositorioDados -> Veiculo;
  RepositorioDados -> Travessia;
  RepositorioDados -> TransacaoBancaria;
  edge [arrowtail=diamond];
  RelatorioRisco -> Alerta [headlabel="0..*", labeldistance=1.8];

  // ---------- Associações ----------
  edge [arrowhead=vee, arrowtail=none, dir=forward, style=solid, label=""];
  Veiculo -> Pessoa [label="proprietário"];
  Travessia -> PostoFronteira;
  Travessia -> Sentido;
  TransacaoBancaria -> TipoTransacao;
  Verificacao -> PostoFronteira;
  Verificacao -> Sentido;
  RelatorioRisco -> NivelRisco;
  RelatorioRisco -> Verificacao;
  RelatorioRisco -> Pessoa [label="condutor"];
  ContextoAnalise -> Verificacao;
  ContextoAnalise -> Veiculo;
  ContextoAnalise -> Pessoa;
  ContextoAnalise -> RepositorioDados;
  AnalisadorFacial -> VerificadorFacial;
  MotorRisco -> VerificadorFacial;
  MotorRisco -> RepositorioDados;
  Analisador -> ConfigRisco;
  CenarioDemo -> Verificacao;

  // ---------- Dependências (uso / criação) ----------
  edge [style=dashed, arrowhead=vee];
  MotorRisco -> RelatorioRisco [label="«cria»"];
  MotorRisco -> ContextoAnalise [label="«cria»"];
  MotorRisco -> RegistroAuditoria [label="«usa»"];
  MotorRisco -> ConfigRisco [label="«usa»"];
  Analisador -> ContextoAnalise [label="«usa»"];
  Analisador -> Alerta [label="«cria»"];
  RegistroAuditoria -> RelatorioRisco [label="«usa»"];
  GeradorDados -> RepositorioDados [label="«popula»"];
  GeradorDados -> CenarioDemo [label="«cria»"];
}
